rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can only read and write their own data.
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      // Users can't give themselves a paid tier: new docs start on "free" and
      // the tier field can't be changed from the app.
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.get('tier', 'free') == 'free';
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.get('tier', 'free') == resource.data.get('tier', 'free');

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
